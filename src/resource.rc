// Bolt Download Manager Resource File
#include "resource.h"

// Application Icon
IDI_BOLT_ICON ICON "bolt.ico"

// Version Information
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bolt"
            VALUE "FileDescription", "Bolt Download Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "bolt"
            VALUE "LegalCopyright", "Open Source"
            VALUE "OriginalFilename", "bolt.exe"
            VALUE "ProductName", "Bolt Download Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
